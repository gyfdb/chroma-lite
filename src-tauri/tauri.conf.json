{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chroma Lite",
  "version": "0.1.0",
  "identifier": "com.barkafterbark.chromalite",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-chroma-lite.rules": "linux/70-chroma-lite.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-chroma-lite.rules": "linux/70-chroma-lite.rules"
        }
      }
    }
  }
}
